# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL. Locally this can be Docker, Postgres.app or a hosted branch.
# On Vercel, add a Postgres database from the Storage tab and this is set for
# you, then run `vercel env pull` to get it locally.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/apple_bros?schema=public"

# ---------------------------------------------------------------------------
# Site (required in production)
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Canonical URLs, Open Graph images, the
# sitemap and every absolute link in an order email are built from this.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Staff area (required to reach /admin)
# ---------------------------------------------------------------------------
# A single shared password guarding /admin and /api/admin. Adequate for one
# shop with a handful of staff; replace with per-user accounts before that
# stops being true.
ADMIN_PASSWORD="change-this-before-you-deploy"
# Used to sign the staff session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Search indexing
# ---------------------------------------------------------------------------
# Set to true on anything that is not the live shop. Adds a noindex header and
# serves a disallow-all robots.txt, so placeholder prices and contact details
# cannot end up in search results. Vercel preview deployments do this
# automatically without the flag.
DEMO_NOINDEX="true"

# ---------------------------------------------------------------------------
# Payments (optional: the shop works without any of these)
# ---------------------------------------------------------------------------
# With nothing set here, checkout completes as EFT or pay on collection, which
# is a real way to sell and needs no integration. Fill in one of the blocks
# below to add a card gateway. Only one provider is active at a time.
#
# PAYMENT_PROVIDER is one of: manual, yoco, payfast, peach, ozow
PAYMENT_PROVIDER="manual"

# Yoco: https://developer.yoco.com
YOCO_SECRET_KEY=""
YOCO_WEBHOOK_SECRET=""

# PayFast: https://developers.payfast.co.za
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""

# Peach Payments: https://developer.peachpayments.com
PEACH_ENTITY_ID=""
PEACH_ACCESS_TOKEN=""

# Ozow: https://ozow.com/integrations
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""

# ---------------------------------------------------------------------------
# Bank details shown for EFT orders
# ---------------------------------------------------------------------------
# Shown on the order confirmation when the customer chooses EFT. Leave unset
# in development; the confirmation then tells the customer the details will
# follow by email rather than printing an empty block.
EFT_BANK_NAME=""
EFT_ACCOUNT_NAME=""
EFT_ACCOUNT_NUMBER=""
EFT_BRANCH_CODE=""

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# Unset, order confirmations are written to the server log instead of sent, and
# the confirmation page carries everything the customer needs. Add a provider
# to send them for real.
NOTIFICATION_PROVIDER="log"
RESEND_API_KEY=""
NOTIFICATION_FROM="orders@theapplebros.co.za"

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Unset, events go to the browser console in development and nowhere in
# production.
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
