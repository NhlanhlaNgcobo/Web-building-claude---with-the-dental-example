# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL. On Vercel, add a Postgres database from the Storage tab and this
# is set for you; pull it locally with `vercel env pull .env`.
#
# If the provider offers a pooled connection string, use that one here.
DATABASE_URL="postgresql://user:password@host:5432/harbour?sslmode=require"

# ---------------------------------------------------------------------------
# Site (required)
# ---------------------------------------------------------------------------
# Canonical URLs, Open Graph tags and the sitemap all derive from this.
# No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Staff area (required)
# ---------------------------------------------------------------------------
# Password for the staff diary at /admin.
ADMIN_PASSWORD="change-me"
# Signs the staff session cookie and the patient appointment management
# tokens. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# Demo deployments (optional)
# ---------------------------------------------------------------------------
# Set to "true" on a preview or client demo deployment. It adds a noindex
# header site wide, so a site that presents as a real dental practice with
# placeholder contact details cannot be picked up by search engines.
DEMO_NOINDEX="false"

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
# "manual" takes deposits at the practice and needs no account. The whole
# booking flow works with this. No card data is stored by this application
# regardless of provider. Adapters slot in behind PaymentProvider in
# lib/providers/payment/.
PAYMENT_PROVIDER="manual"
# YOCO_SECRET_KEY=""
# PAYFAST_MERCHANT_ID=""
# PAYFAST_MERCHANT_KEY=""
# PAYFAST_PASSPHRASE=""
# PEACH_ENTITY_ID=""
# PEACH_ACCESS_TOKEN=""
# OZOW_SITE_CODE=""
# OZOW_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Calendar (optional)
# ---------------------------------------------------------------------------
# "local" generates downloadable .ics files, which Google Calendar, Outlook
# and Apple Calendar all import. No integration required.
CALENDAR_PROVIDER="local"

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# "log" records what would be sent to the server log without contacting any
# external service.
NOTIFICATION_PROVIDER="log"

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Leave blank to keep analytics events local to the browser console.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
